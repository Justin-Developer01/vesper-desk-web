# Supabase Configuration (Client & Server)
# Project ref: mhowgvkyfnzpciwcbivr
NEXT_PUBLIC_SUPABASE_URL=https://mhowgvkyfnzpciwcbivr.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-placeholder

# Supabase Service Role (Server routes only — never expose to browser)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-placeholder

# Server-side Token Encryption Key
# 32-byte secret (e.g. generate with: openssl rand -hex 32)
TOKEN_ENCRYPTION_KEY=your-32-byte-encryption-key-placeholder

# Kick OAuth PKCE Configuration (Server routes only)
KICK_CLIENT_ID=your-kick-client-id-placeholder
KICK_CLIENT_SECRET=your-kick-client-secret-placeholder
# Optional: defaults to ${origin}/auth/kick/callback if omitted
KICK_REDIRECT_URI=https://www.vesperdesk.app/auth/kick/callback
